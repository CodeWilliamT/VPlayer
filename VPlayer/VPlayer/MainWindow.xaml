<local:VcreditWindow x:Name="formWindow" x:Class="VPlayer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:VPlayer" xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        mc:Ignorable="d"
        Style="{StaticResource CustomWindow}"
        Title="VPlayer" Width="968" Height="558" WindowStyle="None" ResizeMode="NoResize"
        BorderBrush="Black" Background="Black" AllowsTransparency="True" AllowDrop="True"   >
    <Grid x:Name="Grid_Form" Background="#01000000" Margin="0,0,0,0">
        <Grid x:Name="Grid_Player" Margin="0,0,0,0" Background="Black" >
            <vlc:VideoView x:Name="PlayerElement" Margin="0,0,0,0" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid x:Name="Grid_Mask" Background="#01000000" Margin="0,0,0,0" AllowDrop="True">
                    <Grid.ContextMenu>
                        <ContextMenu MouseMove="Grid_Mask_MouseMove">
                            <MenuItem Name="menuOpen" Header="打开">
                                <MenuItem Name="menuOpenFile" Header="打开文件"/>
                                <MenuItem Name="menuOpenFolder" Header="打开文件夹"/>
                            </MenuItem>
                            <MenuItem Name="menuSub" Header="字幕">
                                <MenuItem Name="menuSubOpen" Header="加载字幕" />
                                <MenuItem Name="menuSubVisible" Header="隐藏字幕" />
                            </MenuItem>
                            <MenuItem Name="menuPlayOverActions" Header="播放完毕后">
                                <MenuItem Name="menuCheckPlayNext" Header="播下一个" IsCheckable="True" Checked="menuPlayOverActions_Items_Checked" Tag="PlayNext"/>
                                <MenuItem Name="menuCheckPlayThis" Header="重复播放" IsCheckable="True" Checked="menuPlayOverActions_Items_Checked" Tag="PlayThis"/>
                                <MenuItem Name="menuCheckDoNothing" Header="停止" IsCheckable="True" Checked="menuPlayOverActions_Items_Checked" Tag="DoNothing"/>
                            </MenuItem>
                            <MenuItem Name="menuZoomModes" Header="缩放">
                                <MenuItem Name="menuStetch" Header="缩放" IsCheckable="True" Checked="menuZoomModes_Items_Checked" Tag="Stetch"/>
                                <MenuItem Name="menuFill" Header="纵向填充" IsCheckable="True" Checked="menuZoomModes_Items_Checked" Tag="Fill"/>
                            </MenuItem>
                            <MenuItem Name="menuView" Header="画面">
                                <MenuItem Name="menuViewClock90" Header="顺时针旋转90度"  />
                                <MenuItem Name="menuViewRClock90" Header="逆时针旋转90度"  />
                                <MenuItem Name="menuViewZoomUp" Header="放大0.25(当前视窗)"  />
                                <MenuItem Name="menuViewZoomDown" Header="缩小0.25(当前视窗)"  />
                            </MenuItem>
                            <MenuItem Name="menuOpenDir" Header="打开当前目录" />
                            <MenuItem Name="menuScreen" Header="全屏" />
                            <MenuItem Name="menuTop" Header="最前显示" />
                            <MenuItem Name="menuSetDefault" Header="设为默认媒体程序"  />
                            <MenuItem Name="menuInstallHEVC" Header="从微软商城安装HEVC解码器"   />
                        </ContextMenu>
                    </Grid.ContextMenu>
                    <Grid x:Name="Grid_Center" Margin="0,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="5" />
                            <ColumnDefinition Width="270" />
                        </Grid.ColumnDefinitions>
                        <Grid x:Name="Grid_Main" Margin="0,0,0,0" Grid.Column="0">
                            <Grid x:Name="Grid_Top" Height="60" VerticalAlignment="Top" Background="#00000000">
                                <Canvas x:Name="Canvas_Top" Height="30" VerticalAlignment="Top" Background="#33000000">
                                    <Label x:Name="label_NowFile" Content="VPlayer By WilliamT" Canvas.Top="0" Foreground="White" Width="auto" Height="auto" />
                                    <Button x:Name="btnTop" Content="" Canvas.Right="100" Width="25" Height="25" Canvas.Top="0" Style="{StaticResource CustomButton}" >
                                        <Button.Background>
                                            <ImageBrush ImageSource="Images/NotPin.png"/>
                                        </Button.Background>
                                    </Button>
                                    <Button x:Name="btnMin" Content="" Canvas.Right="70" Canvas.Top="0" Width="25" Height="25" Style="{StaticResource CustomButton}" >
                                        <Button.Background>
                                            <ImageBrush ImageSource="Images/Min.png"/>
                                        </Button.Background>
                                    </Button>
                                    <Button x:Name="btnMax" Content="" Canvas.Right="40" Canvas.Top="0" Width="25" Height="25" Style="{StaticResource CustomButton}" >
                                        <Button.Background>
                                            <ImageBrush ImageSource="Images/Max.png"/>
                                        </Button.Background>
                                    </Button>
                                    <Button x:Name="btnClose" Content="" Canvas.Right="10" Canvas.Top="0" Width="25" Height="25" Style="{StaticResource CustomButton}" >
                                        <Button.Background>
                                            <ImageBrush ImageSource="Images/Close.png"/>
                                        </Button.Background>
                                    </Button>
                                    <Button x:Name="btnOpenFile_Copy" Content="" Canvas.Right="125" Canvas.Top="0" Width="25" Height="25" Style="{StaticResource CustomButton}"  >
                                        <Button.Background>
                                            <ImageBrush ImageSource="Images/OpenFile.png"/>
                                        </Button.Background>
                                    </Button>
                                    <Label x:Name="label_time" Content="XX:XX:XX" Foreground="White" Canvas.Right="165" Canvas.Top="0" Height="25" HorizontalAlignment="Right" VerticalAlignment="Top"/>
                                </Canvas>
                            </Grid>
                            <Grid x:Name="Grid_Sub" Margin="0,0,0,0">
                                <TextBlock x:Name="textBlock_Log" HorizontalAlignment="Left" Margin="15,30,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Foreground="White" FontSize="16"/>
                                <TextBlock x:Name="tbSubUp" HorizontalAlignment="Center" Margin="0,0,0,62" TextWrapping="Wrap" Text="{Binding Text, ElementName=tbSub}" VerticalAlignment="Bottom" RenderTransformOrigin="2.545,0.762" Foreground="Black" FontSize="{Binding FontSize, ElementName=tbSub}" TextAlignment="Center" FontWeight="{Binding FontWeight, ElementName=tbSub}" Visibility="{Binding Visibility, ElementName=tbSub}"/>
                                <TextBlock x:Name="tbSubDown" HorizontalAlignment="Center" Margin="0,0,0,58" TextWrapping="Wrap" Text="{Binding Text, ElementName=tbSub}" VerticalAlignment="Bottom" RenderTransformOrigin="2.545,0.762" Foreground="Black" FontSize="{Binding FontSize, ElementName=tbSub}" TextAlignment="Center" FontWeight="{Binding FontWeight, ElementName=tbSub}" Visibility="{Binding Visibility, ElementName=tbSub}"/>
                                <TextBlock x:Name="tbSubLeft" HorizontalAlignment="Center" Margin="2,0,0,60" TextWrapping="Wrap" Text="{Binding Text, ElementName=tbSub}" VerticalAlignment="Bottom" RenderTransformOrigin="2.545,0.762" Foreground="Black" FontSize="{Binding FontSize, ElementName=tbSub}" TextAlignment="Center" FontWeight="{Binding FontWeight, ElementName=tbSub}" Visibility="{Binding Visibility, ElementName=tbSub}"/>
                                <TextBlock x:Name="tbSubRight" HorizontalAlignment="Center" Margin="0,0,2,60" TextWrapping="Wrap" Text="{Binding Text, ElementName=tbSub}" VerticalAlignment="Bottom" RenderTransformOrigin="2.545,0.762" Foreground="Black" FontSize="{Binding FontSize, ElementName=tbSub}" TextAlignment="Center" FontWeight="{Binding FontWeight, ElementName=tbSub}" Visibility="{Binding Visibility, ElementName=tbSub}"/>
                                <TextBlock x:Name="tbSub" HorizontalAlignment="Center" Margin="0,0,0,60" TextWrapping="Wrap" Text="" VerticalAlignment="Bottom" RenderTransformOrigin="2.545,0.762" Foreground="White" FontSize="17" TextAlignment="Center" FontWeight="Bold"/>
                            </Grid>
                            <Grid x:Name="Grid_Menu" Height="80" Margin="0" VerticalAlignment="Bottom" Opacity="0.95" Background="#7F000000">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="631*"/>
                                    <ColumnDefinition Width="61*"/>
                                </Grid.ColumnDefinitions>
                                <Label x:Name="Label_Process" Foreground="White" Margin="0,24,0,0" Background="#0C000000" Opacity="0.95" Grid.ColumnSpan="2"/>

                                <Slider x:Name="Slider_Process"  Margin="35,4,35,52" Width="{Binding Width, ElementName=GirdMenu}"  SmallChange="5" Interval="5" IsMoveToPointEnabled="True" Focusable="False" Cursor="Hand" PreviewMouseUp="Slider_Process_MouseUp" MouseMove="Slider_Process_MouseMove" Grid.ColumnSpan="2"  />
                                <Button x:Name="btnLeft" Width="24" Foreground="#FF6E6E6E" Height="24" RenderTransformOrigin="0.958,1" Style="{StaticResource CustomButton}" Margin="6,2,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Focusable="False" >
                                    <Button.Background>
                                        <ImageBrush ImageSource="Images/ToLeft.png"/>
                                    </Button.Background>
                                </Button>
                                <Button x:Name="btnRight" Width="24" Foreground="#FF6E6E6E" Height="24"  RenderTransformOrigin="0.875,1.625" Style="{StaticResource CustomButton}" Margin="0,2,6,0" HorizontalAlignment="Right" VerticalAlignment="Top" Focusable="False" Grid.Column="1" >
                                    <Button.Background>
                                        <ImageBrush ImageSource="Images/ToRight.png"/>
                                    </Button.Background>
                                </Button>
                                <Canvas Height="42" Width="194" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,30,0,0">
                                    <Button x:Name="btnStop" Canvas.Left="2" Canvas.Top="5" Width="38" Foreground="#FF6E6E6E" Height="33" Style="{StaticResource CustomButton}" Focusable="False" >
                                        <Button.Background>
                                            <ImageBrush ImageSource="Images/Stop.png"/>
                                        </Button.Background>
                                    </Button>
                                    <Button x:Name="btnLast" Canvas.Left="52" Width="37" Foreground="#FF6E6E6E" Height="26" Style="{StaticResource CustomButton}" Focusable="False" Canvas.Top="7" >
                                        <Button.Background>
                                            <ImageBrush ImageSource="Images/Last.png"/>
                                        </Button.Background>
                                    </Button>

                                    <Button x:Name="btnStart" Canvas.Left="97" Width="43" Height="36" Style="{StaticResource CustomButton}" >
                                        <Button.Background>
                                            <ImageBrush ImageSource="Images/Start.png"/>
                                        </Button.Background>
                                    </Button>
                                    <Button x:Name="btnNext" Canvas.Left="148" Canvas.Top="5" Width="37" Foreground="#FF6E6E6E" Height="26" Style="{StaticResource CustomButton}" Focusable="False" >
                                        <Button.Background>
                                            <ImageBrush ImageSource="Images/Next.png"/>
                                        </Button.Background>
                                    </Button>
                                </Canvas>

                                <Canvas Height="42" Width="250" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,26,5,0" Grid.ColumnSpan="2">
                                    <Label x:Name="label_speed" Content="倍速:" Margin="40,5,0,0" VerticalAlignment="Top" Foreground="White" HorizontalAlignment="Left"/>
                                    <TextBlock x:Name="textBlock_speed" Margin="75,10,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="20" Foreground="White" Text="1.0" Height="19" Background="#00000000" HorizontalAlignment="Left"/>
                                    <Slider x:Name="Slider_Speed" Margin="90,10,0,0" Width="78" Interval="1" Maximum="30" Value="10" ValueChanged="Slider_Speed_ValueChanged" SmallChange="1" HorizontalAlignment="Left" Height="18" VerticalAlignment="Top" Focusable="False" Cursor="Hand" ToolTip="加速/减速(Ctrl+↑/↓)"/>
                                    <Button x:Name="btnVoice" Margin="165,7,0,0" Width="25" Foreground="#FF6E6E6E" Height="25" Style="{StaticResource CustomButton}" HorizontalAlignment="Left" VerticalAlignment="Top" >
                                        <Button.Background>
                                            <ImageBrush ImageSource="Images/Sound.png"/>
                                        </Button.Background>
                                    </Button>

                                    <Button x:Name="btnSub" Margin="190,5,0,0" Width="24" Height="24" Foreground="#FF6E6E6E" Style="{StaticResource CustomButton}" HorizontalAlignment="Left" VerticalAlignment="Top" Focusable="False" >
                                        <Button.Background>
                                            <ImageBrush ImageSource="Images/Sub.png"/>
                                        </Button.Background>
                                    </Button>
                                    <Button x:Name="btnScreen" Margin="220,5,0,0" Width="24" Height="24" Foreground="#FF6E6E6E" Style="{StaticResource CustomButton}" HorizontalAlignment="Left" VerticalAlignment="Top" Focusable="False" >
                                        <Button.Background>
                                            <ImageBrush ImageSource="Images/Screen.png"/>
                                        </Button.Background>
                                    </Button>
                                    <Canvas x:Name="Canvas_Voice" Margin="124,-120,0,0" ToolTip="声音" Height="120" Width="35" Background="#FF303030" HorizontalAlignment="Left" VerticalAlignment="Top">
                                        <Slider x:Name="Slider_Voice" Canvas.Left="-25" Canvas.Top="39" Width="86" RenderTransformOrigin="0.5,0.5" Maximum="100" SmallChange="1" TickFrequency="10" ValueChanged="Slider_Vioce_ValueChanged" Interval="1" IsMoveToPointEnabled="True" AutoToolTipPlacement="BottomRight" Cursor="Hand">
                                            <Slider.RenderTransform>
                                                <TransformGroup>
                                                    <ScaleTransform/>
                                                    <SkewTransform/>
                                                    <RotateTransform Angle="-90"/>
                                                    <TranslateTransform/>
                                                </TransformGroup>
                                            </Slider.RenderTransform>
                                        </Slider>
                                        <Button x:Name="btn_Silence" Content="" Canvas.Left="5" Canvas.Top="96" Width="25" Height="25" Style="{StaticResource CustomButton}" Focusable="False" >
                                            <Button.Background>
                                                <ImageBrush ImageSource="Images/Sound.png"/>
                                            </Button.Background>
                                        </Button>
                                    </Canvas>
                                    <Canvas x:Name="Canvas_Sub" Margin="160,-60,0,0" ToolTip="字幕" Height="62" Width="90" Background="#FF303030" HorizontalAlignment="Left" VerticalAlignment="Top" Visibility="Visible">
                                        <Button x:Name="btnSubOpen" Content="加载字幕" Canvas.Left="0" Canvas.Top="0" Width="90" Height="30" RenderTransformOrigin="0.5,0.455" Background="#FF0E0E0E" Focusable="False" Foreground="White" />
                                        <Button x:Name="btnSubVisible" Content="隐藏字幕" Canvas.Left="0" Canvas.Top="31" Width="90" Height="30" RenderTransformOrigin="0.5,0.455" Background="#FF0E0E0E" Focusable="False" Foreground="White" />
                                    </Canvas>
                                </Canvas>

                            </Grid>
                        </Grid>
                        <Button x:Name="btnShowList" Width="25"  Height="100" Grid.Column="0" Margin="0,0,0,0" Content="&gt;" HorizontalAlignment="Right" Background="Black" Opacity="0.95" Foreground="White" Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}"  />

                        <GridSplitter x:Name="GridSplitter_List" Grid.Column="1"  Background="#CC282828" HorizontalAlignment="Stretch" Focusable="False" />
                        <TreeView x:Name="TreeView_File" Grid.Column="2"  Background="#CC383838" Foreground="#FFB1B1B1" ScrollViewer.VerticalScrollBarVisibility="Auto" BorderBrush="#00ABADB3" BorderThickness="0" >
                            <TreeView.ItemTemplate>
                                <HierarchicalDataTemplate DataType="{x:Type local:MediaFileNode}" ItemsSource="{Binding Childs}">
                                    <TextBlock Text="{Binding Name}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="Background" Value="Gray"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsRecorded}" Value="True">
                                                        <Setter Property="Foreground" Value="LightGray"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsUsing}" Value="True">
                                                        <Setter Property="Foreground" Value="SkyBlue"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </HierarchicalDataTemplate>
                            </TreeView.ItemTemplate>
                            <TreeView.ItemContainerStyle>
                                <Style TargetType="TreeViewItem">
                                    <!--<Setter Property="IsSelected" Value="{Binding IsSelected}" />-->
                                    <Setter Property="IsExpanded" Value="{Binding IsExpanded}" />
                                    <Setter Property="ContextMenu" Value="{Binding ContextMenu}"/>
                                    <Setter Property="ToolTip" Value="{Binding Name}"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <EventSetter Event="TreeViewItem.PreviewMouseRightButtonDown" Handler="TreeViewItem_PreviewMouseRightButtonDown"/>

                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding  RelativeSource={RelativeSource self},Path=IsSelected}" Value="True">
                                            <Setter Property="BorderThickness" Value="1"/>
                                            <Setter Property="BorderBrush" Value="Green"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TreeView.ItemContainerStyle>

                            <TreeView.ContextMenu>
                                <ContextMenu MouseMove="Grid_Mask_MouseMove">
                                    <MenuItem Name="menuDeleteNodeRecord" Header="删除节点记录"  />
                                    <MenuItem Name="menuOpenNodeFolder" Header="打开节点目录" />
                                    <MenuItem Name="menuClearList" Header="清空播放记录" />
                                </ContextMenu>
                            </TreeView.ContextMenu>
                        </TreeView>

                    </Grid>
                    <Canvas x:Name="Canvas_File" Margin="0,0,0,0" Height="40" HorizontalAlignment="Center" Width="190" VerticalAlignment="Center">
                        <Button x:Name="btnOpenFile" Content="打开文件" HorizontalAlignment="Left" Margin="0,0,0,0" VerticalAlignment="Top" Width="80" RenderTransformOrigin="0.5,0.455" Background="#FF0E0E0E" Foreground="White" />
                        <Button x:Name="btnDown" Content="▼" Canvas.Left="78" Width="28" Background="#FF0E0E0E" Foreground="White" />
                        <Button x:Name="btnOpenFolder" Content="打开文件夹" HorizontalAlignment="Left" Margin="0,0,0,0" VerticalAlignment="Top" Width="106" RenderTransformOrigin="0.491,0.5" Background="#FF0E0E0E" Foreground="White" Canvas.Top="18" Height="20" Visibility="Visible" />

                    </Canvas>
                </Grid>
            </vlc:VideoView>
        </Grid>
    </Grid>
</local:VcreditWindow>
